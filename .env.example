# BDuong Store - Environment Variables (Optional)
# Nếu bạn chưa điền Supabase URL và ANON KEY, hệ thống sẽ tự động chạy chế độ Mock Data (LocalStorage)
# Cho phép trải nghiệm đầy đủ Mua hàng tự động, Đổi theme, Admin CRUD ngay lập tức.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# SePay API Token (Lấy tại https://my.sepay.vn/user/api-key)
# Cho phép frontend tự động quét biến động số dư tài khoản MBBank 2222226062005
VITE_SEPAY_API_TOKEN=
